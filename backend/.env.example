# Copy this file to .env and fill in the values
PORT=2003
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/telemedicine_db

# Gmail account used to send password-reset OTP emails (use a Gmail App Password)
SMTP_EMAIL=
SMTP_PASSWORD=

# Firebase Cloud Messaging (push notifications)
FIREBASE_PROJECT_ID=
# Path to the Firebase service account JSON (default: ./serviceAccountKey.json)
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Admin dashboard login tokens (use a long random string)
ADMIN_JWT_SECRET=change-me-to-a-long-random-string
ADMIN_JWT_EXPIRES_IN=12h

# Main dashboard admin created by `npm run seed:admins`
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PHONE=
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=
