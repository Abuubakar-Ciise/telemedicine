# Copy this file to .env (same folder) and fill in the values.
# Backend API: your PC's IPv4 address (run "ipconfig"). Can be changed in the app: login screen > Server settings
BASE_URL=http://192.168.100.8:2003

# ZEGOCLOUD (video/voice calls) - from https://console.zegocloud.com
APPID=0
APPSING=

# Firebase (from the Firebase console > Project settings)
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=

# WaafiPay payment gateway
# mock = payments are simulated (number ending in 0000 = rejected). live = real WaafiPay (needs the 3 keys below)
PAYMENT_MODE=mock
MERCHANTUID=
APIUSERID=
APIKEY=
